\
    <!-- \uc0\u12490 \u12499 \u12466 \u12540 \u12471 \u12519 \u12531 \u12513 \u12491 \u12517 \u12540  -->\
    <nav class="nav-bar">\
        <button class="nav-btn active" data-target="dashboard-view">\uc0\u12480 \u12483 \u12471 \u12517 \u12508 \u12540 \u12489 </button>\
        <button class="nav-btn" data-target="cases-view">\uc0\u12465 \u12540 \u12473 \u19968 \u35239 </button>\
        <button class="nav-btn" data-target="billing-view">\uc0\u22770 \u19978 \u12539 \u35531 \u27714 </button>\
        <button class="nav-btn" data-target="calendar-view">\uc0\u12459 \u12524 \u12531 \u12480 \u12540 </button>\
    </nav>\
\
    <script>\
        // \uc0\u12479 \u12502 \u20999 \u12426 \u26367 \u12360 \u20966 \u29702 \
        document.querySelectorAll('.nav-btn').forEach(button => \{\
            button.addEventListener('click', (e) => \{\
                document.querySelectorAll('.view-section').forEach(view => view.classList.remove('active'));\
                document.querySelectorAll('.nav-btn').forEach(btn => btn.classList.remove('active'));\
                \
                const targetId = e.target.getAttribute('data-target');\
                document.getElementById(targetId).classList.add('active');\
                e.target.classList.add('active');\
\
                // \uc0\u30011 \u38754 \u12434 \u38283 \u12356 \u12383 \u12392 \u12365 \u12395 \u12487 \u12540 \u12479 \u12434 \u26368 \u26032 \u21270 \u12377 \u12427 \
                if (targetId === 'billing-view') \{\
                    updateBillingView();\
                \} else if (targetId === 'cases-view') \{\
                    updateCasesView();\
                \}\
            \});\
        \});\
\
        // \uc0\u21021 \u26399 \u12469 \u12531 \u12503 \u12523 \u12487 \u12540 \u12479 \u12398 \u33258 \u21205 \u29983 \u25104 \u65288 \u21021 \u22238 \u36215 \u21205 \u26178 \u65289 \
        function initData() \{\
            if (!localStorage.getItem('labo_cases')) \{\
                const sampleData = [\
                    \{ id: 1, hospital: '\uc0\u12373 \u12367 \u12425 \u27503 \u31185 ', patient: '\u23665 \u30000  \u22826 \u37070 ', status: 'completed', price: 15000, date: new Date().toISOString().slice(0, 10) \},\
                    \{ id: 2, hospital: '\uc0\u12402 \u12414 \u12431 \u12426 \u27503 \u31185 ', patient: '\u20304 \u34276  \u33457 \u23376 ', status: 'completed', price: 22000, date: new Date().toISOString().slice(0, 10) \},\
                    \{ id: 3, hospital: '\uc0\u12373 \u12367 \u12425 \u27503 \u31185 ', patient: '\u37428 \u26408  \u19968 \u37070 ', status: 'progress', price: 18000, date: new Date().toISOString().slice(0, 10) \}\
                ];\
                localStorage.setItem('labo_cases', JSON.stringify(sampleData));\
            \}\
        \}\
        initData();\
\
        // \uc0\u21205 \u20316 \u30906 \u35469 \u29992 \u12398 \u12486 \u12473 \u12488 \u12465 \u12540 \u12473 \u36861 \u21152 \u27231 \u33021 \
        function addSampleCase() \{\
            const cases = JSON.parse(localStorage.getItem('labo_cases')) || [];\
            const hospitals = ['\uc0\u12373 \u12367 \u12425 \u27503 \u31185 ', '\u12402 \u12414 \u12431 \u12426 \u27503 \u31185 ', '\u12463 \u12525 \u12540 \u12496 \u12540 \u30703 \u27491 \u27503 \u31185 '];\
            const randomHospital = hospitals[Math.floor(Math.random() * hospitals.length)];\
            const newCase = \{\
                id: Date.now(),\
                hospital: randomHospital,\
                patient: '\uc0\u24739 \u32773  ' + Math.floor(Math.random() * 100),\
                status: 'completed',\
                price: Math.floor(Math.random() * 3 + 1) * 10000,\
                date: new Date().toISOString().slice(0, 10)\
            \};\
            cases.push(newCase);\
            localStorage.setItem('labo_cases', JSON.stringify(cases));\
            alert('\uc0\u12486 \u12473 \u12488 \u12465 \u12540 \u12473 \u12434 \u36861 \u21152 \u12375 \u12414 \u12375 \u12383 \u65281 \u12300 \u22770 \u19978 \u12539 \u35531 \u27714 \u12301 \u12479 \u12502 \u12391 \u38598 \u35336 \u12434 \u30906 \u35469 \u12391 \u12365 \u12414 \u12377 \u12290 ');\
        \}\
\
        // \uc0\u12465 \u12540 \u12473 \u19968 \u35239 \u12398 \u26356 \u26032 \
        function updateCasesView() \{\
            const cases = JSON.parse(localStorage.getItem('labo_cases')) || [];\
            const tbody = document.getElementById('cases-tbody');\
            tbody.innerHTML = '';\
            cases.forEach(c => \{\
                const tr = document.createElement('tr');\
                tr.innerHTML = `\
                    <td>$\{c.hospital\}</td>\
                    <td>$\{c.patient\}</td>\
                    <td>$\{c.status === 'completed' ? '\uc0\u23436 \u20102 ' : '\u36914 \u34892 \u20013 '\}</td>\
                    <td>\'a5$\{Number(c.price).toLocaleString()\}</td>\
                `;\
                tbody.appendChild(tr);\
            \});\
        \}\
\
        // \uc0\u22770 \u19978 \u12539 \u35531 \u27714 \u12499 \u12517 \u12540 \u12398 \u38598 \u35336 \u12392 \u34920 \u31034 \u26356 \u26032 \
        function updateBillingView() \{\
            const cases = JSON.parse(localStorage.getItem('labo_cases')) || [];\
            const currentMonth = new Date().toISOString().slice(0, 7); // "YYYY-MM"\
            \
            let totalRevenue = 0;\
            let totalCount = 0;\
            const hospitalMap = \{\};\
\
            cases.forEach(c => \{\
                // \uc0\u20170 \u26376 \u12398 \u12300 \u23436 \u20102 \u12301 \u12465 \u12540 \u12473 \u12434 \u23550 \u35937 \u12395 \u38598 \u35336 \
                if (c.status === 'completed' && c.date && c.date.startsWith(currentMonth)) \{\
                    const price = Number(c.price) || 0;\
                    totalRevenue += price;\
                    totalCount++;\
\
                    if (!hospitalMap[c.hospital]) \{\
                        hospitalMap[c.hospital] = \{ count: 0, subtotal: 0 \};\
                    \}\
                    hospitalMap[c.hospital].count++;\
                    hospitalMap[c.hospital].subtotal += price;\
                \}\
            \});\
\
            // \uc0\u21512 \u35336 \u20516 \u12398 \u21453 \u26144 \
            document.getElementById('monthly-total').textContent = `\'a5$\{totalRevenue.toLocaleString()\}`;\
            document.getElementById('monthly-count').textContent = `$\{totalCount\}\uc0\u20214 `;\
\
            // \uc0\u12486 \u12540 \u12502 \u12523 \u12398 \u21453 \u26144 \
            const tbody = document.getElementById('billing-tbody');\
            tbody.innerHTML = '';\
            \
            if (Object.keys(hospitalMap).length === 0) \{\
                tbody.innerHTML = `<tr><td colspan="3" style="text-align: center; color: #888;">\uc0\u20170 \u26376 \u12398 \u23436 \u20102 \u12487 \u12540 \u12479 \u12399 \u12354 \u12426 \u12414 \u12379 \u12435 </td></tr>`;\
                return;\
            \}\
\
            for (const [hospital, data] of Object.entries(hospitalMap)) \{\
                const tr = document.createElement('tr');\
                tr.innerHTML = `\
                    <td>$\{hospital\}</td>\
                    <td>$\{data.count\}\uc0\u20214 </td>\
                    <td>\'a5$\{data.subtotal.toLocaleString()\}</td>\
                `;\
                tbody.appendChild(tr);\
            \}\
        \}\
\
        // CSV\uc0\u12456 \u12463 \u12473 \u12509 \u12540 \u12488 \u27231 \u33021 \
        function exportCSV() \{\
            const cases = JSON.parse(localStorage.getItem('labo_cases')) || [];\
            const currentMonth = new Date().toISOString().slice(0, 7);\
            \
            let csv = '\\uFEFF\uc0\u27503 \u31185 \u21307 \u38498 \u21517 ,\u24739 \u32773 \u21517 ,\u12473 \u12486 \u12540 \u12479 \u12473 ,\u37329 \u38989 ,\u26085 \u20184 \\n';\
            let hasData = false;\
            \
            cases.forEach(c => \{\
                if (c.status === 'completed' && c.date && c.date.startsWith(currentMonth)) \{\
                    csv += `"$\{c.hospital\}","$\{c.patient\}","$\{c.status\}","$\{c.price\}","$\{c.date\}"\\n`;\
                    hasData = true;\
                \}\
            \});\
\
            if (!hasData) \{\
                alert('\uc0\u12456 \u12463 \u12473 \u12509 \u12540 \u12488 \u12391 \u12365 \u12427 \u20170 \u26376 \u12398 \u23436 \u20102 \u12487 \u12540 \u12479 \u12364 \u12354 \u12426 \u12414 \u12379 \u12435 \u12290 ');\
                return;\
            \}\
\
            const blob = new Blob([csv], \{ type: 'text/csv;charset=utf-8;' \});\
            const url = URL.createObjectURL(blob);\
            const a = document.createElement('a');\
            a.href = url;\
            a.download = `billing_$\{currentMonth\}.csv`;\
            a.click();\
            URL.revokeObjectURL(url);\
        \}\
    </script>\
</body>\
